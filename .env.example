# ---- Server ----
PORT=4000

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=actionflow
DB_USER=actionflow
DB_PASSWORD=actionflow
# Only used by docker-compose to initialise the container
DB_ROOT_PASSWORD=rootpass

# ---- AI ----
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Used automatically if the main model is overloaded (503) or retired (404)
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash
# Messages sent to Gemini per request (batching keeps free-tier usage low)
AI_BATCH_SIZE=5
# Set to "heuristic" to run without any API key (rule-based, clearly labelled in the UI)
AI_PROVIDER=gemini
